<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RefactorMCP.MCP.Server</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>RefactorMCP</Authors>
    <Description>MCP Server library for RefactorMCP - Model Context Protocol integration</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RefactorMCP.Core\RefactorMCP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <publicsVisibleTo Include="RefactorMCP.Tests" />
    <publicsVisibleTo Include="RefactorMCP.Web" />
  </ItemGroup>

</Project>