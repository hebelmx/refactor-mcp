<!-- Global MSBuild properties for RefactorMCP solution -->
<Project>

  <!-- Common properties for all projects -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>NU1903;NU1510;NU5104;xUnit1051</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Avoid network issues -->
    <RestoreNoHttpCache>true</RestoreNoHttpCache>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>

    <!-- Version information -->
    <MajorVersion>1</MajorVersion>
    <MinorVersion>0</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <VersionPrefix>$(MajorVersion).$(MinorVersion).$(PatchVersion)</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">debug</VersionSuffix>
    
    <!-- Build information -->
    <BuildId Condition="'$(BuildId)' == ''">dev-$(USER)$([System.DateTime]::Now.ToString('yyyyMMdd-HHmmss'))</BuildId>
    
    <!-- Common assembly attributes -->
    <Product>RefactorMCP</Product>
    <Company>RefactorMCP</Company>
    <Authors>RefactorMCP Contributors</Authors>
    <Copyright>© RefactorMCP Contributors</Copyright>
    <Description>RefactorMCP - Model Context Protocol server for C# refactoring tools</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/refactor-mcp/refactor-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/refactor-mcp/refactor-mcp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Package metadata -->
    <PackageTags>refactoring;roslyn;mcp;csharp;dotnet;code-analysis</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md for release notes</PackageReleaseNotes>
    
    <!-- Source control and deterministic builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic Condition="'$(CI)' == 'true'">true</Deterministic>
    
    <!-- Code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    
    <!-- Output and intermediate paths (override to build outside repo) -->
    <BaseOutputPath>F:\Dynamic\Refactor\Refactor\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>F:\Dynamic\Refactor\Refactor\obj\</BaseIntermediateOutputPath>
    <OutputPath>$(BaseOutputPath)$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(MSBuildProjectName)\$(Configuration)\</IntermediateOutputPath>
    
    <!-- NuGet Cache Configuration - Always use local cache first -->
    <RestoreNoHttpCache>true</RestoreNoHttpCache>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <RestoreDisableParallel>false</RestoreDisableParallel>
    
    <!-- Assembly and file versioning -->
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(MajorVersion).$(MinorVersion).0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(MajorVersion).$(MinorVersion).$(PatchVersion).0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(VersionPrefix)$(VersionSuffix)+$(BuildId)</InformationalVersion>
  </PropertyGroup>

  <!-- Test projects configuration -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn> <!-- Missing XML comments in test projects -->
  </PropertyGroup>

  <!-- Package projects configuration -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildThisFileDirectory)packages</PackageOutputPath>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <IncludeSource>true</IncludeSource>
  </PropertyGroup>

  <!-- Web projects configuration -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.Web'">
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <!-- Global package references for all projects -->
  <ItemGroup>
    <!-- Global package references moved to individual project files when needed -->
    <!-- Central package versions are in Directory.Packages.props -->
  </ItemGroup>

  <!-- Test projects package references -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="All" />
    <PackageReference Include="coverlet.collector" PrivateAssets="All" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />

    <!-- Central package versions moved to Directory.Packages.props -->
  </ItemGroup>

  <!-- Global using statements -->
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <!-- Test project using statements -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="Moq" />
  </ItemGroup>

  <!-- Compiler constants -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- StyleCop configuration -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)stylecop.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Exclude generated files from code analysis -->
  <ItemGroup>
    <Compile Remove="**/bin/**" />
    <Compile Remove="**/obj/**" />
    <None Remove="**/bin/**" />
    <None Remove="**/obj/**" />
  </ItemGroup>

  <!-- Common project files to include in packages -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="true" PackagePath="" Condition="Exists('$(MSBuildThisFileDirectory)CHANGELOG.md')" />
  </ItemGroup>

  <!-- Assembly metadata item group -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildId" Value="$(BuildId)" />
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="BuildPlatform" Value="$(Platform)" />
  </ItemGroup>

  <!-- Custom targets for build information -->
  <Target Name="DisplayBuildInfo" BeforeTargets="Build">
    <Message Text="Building $(MSBuildProjectName)" Importance="high" />
    <Message Text="Configuration: $(Configuration)" Importance="high" />
    <Message Text="Platform: $(Platform)" Importance="high" />
    <Message Text="Build ID: $(BuildId)" Importance="high" />
    <Message Text="Version: $(InformationalVersion)" Importance="high" />
    <Message Text="Output Path: $(OutputPath)" Importance="high" />
  </Target>

  <!-- Custom target to generate build metadata -->
  <Target Name="GenerateBuildMetadata" AfterTargets="Build">
    <PropertyGroup>
      <BuildMetadataPath>$(OutputPath)build-metadata.json</BuildMetadataPath>
    </PropertyGroup>
    
    <WriteLinesToFile File="$(BuildMetadataPath)" Lines="
{
  &quot;project&quot;: &quot;$(MSBuildProjectName)&quot;,
  &quot;version&quot;: &quot;$(InformationalVersion)&quot;,
  &quot;configuration&quot;: &quot;$(Configuration)&quot;,
  &quot;platform&quot;: &quot;$(Platform)&quot;,
  &quot;buildId&quot;: &quot;$(BuildId)&quot;,
  &quot;buildTime&quot;: &quot;$([System.DateTime]::UtcNow.ToString('o'))&quot;,
  &quot;targetFramework&quot;: &quot;$(TargetFramework)&quot;,
  &quot;outputType&quot;: &quot;$(OutputType)&quot;,
  &quot;assemblyName&quot;: &quot;$(AssemblyName)&quot;
}" Overwrite="true" />
    
    <Message Text="Generated build metadata: $(BuildMetadataPath)" Importance="normal" />
  </Target>

</Project>