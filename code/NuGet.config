<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Enhanced NuGet stability for all restore operations -->
    <add key="globalPackagesFolder" value="packages" />
    <add key="repositoryPath" value="packages" />
    <add key="defaultPushSource" value="https://api.nuget.org/v3/index.json" />
    <!-- Force these settings for all operations -->
    <add key="http_proxy.bypassonlocal" value="true" />
  </config>
  
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Local" value="C:\Nuggets" />
  </packageSources>
  
  <packageRestore>
    <!-- Force these restore settings at solution level -->
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
</configuration>