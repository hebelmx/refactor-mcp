		<PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageVersion Include="Serilog.Sinks.Seq" Version="9.0.0" />
		<PackageVersion Include="Serilog.Sinks.XUnit" Version="3.0.19" />
		<PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
		<PackageVersion Include="Serilog.Settings.Configuration" Version="9.0.1-dev-02317" />
		<PackageVersion Include="Serilog.Enrichers.OpenTelemetry" Version="1.0.1" />
		<PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.1-dev-02306" />
		<!-- ===================================================================== -->
		<!-- Testing Framework & Tools                                            -->
		<!-- ===================================================================== -->
		<!-- xUnit Testing Framework -->
		<PackageVersion Include="xunit.v3" Version="3.0.1" />
		<PackageVersion Include="xunit.v3.core" Version="3.0.1" />
		<PackageVersion Include="xunit.v3.common" Version="3.0.1" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
		<PackageVersion Include="xunit.v3.runner.msbuild" Version="3.0.1" />
		<PackageVersion Include="xunit.v3.runner.inproc.console" Version="3.0.1" />
		<PackageVersion Include="Xunit.DependencyInjection" Version="10.6.0" />
		<PackageVersion Include="Microsoft.Playwright.Xunit" Version="1.42.0" />
		<!-- Compatibility packages for xUnit v3 -->
		<!-- Microsoft Testing Platform -->
		<PackageVersion Include="Microsoft.Testing.Platform" Version="1.8.2" />
		<PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="1.8.2" />
		<PackageVersion Include="Microsoft.Testing.Extensions.Telemetry" Version="1.8.2" />
		<PackageVersion Include="Microsoft.Testing.Extensions.VSTestBridge" Version="1.8.2" />
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.8.2" />
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="1.8.2" />
		<PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageVersion Include="Meziantou.Extensions.Logging.Xunit.v3" Version="1.1.12" />
		<!-- Test Coverage & Mocking -->
		<PackageVersion Include="coverlet.collector" Version="6.0.4" />
		<PackageVersion Include="NSubstitute" Version="5.3.0" />
		<PackageVersion Include="Shouldly" Version="4.3.0" />
		<!-- Component Testing -->
		<PackageVersion Include="bUnit" Version="1.40.0" />
		<!-- ===================================================================== -->
		<!-- Code Quality & Analysis Tools                                        -->
		<!-- ===================================================================== -->
		<PackageVersion Include="SonarAnalyzer.CSharp" Version="10.15.0.120848" />
		<PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.507" />
		<!-- ===================================================================== -->
		<!-- Source Control & Build Tools                                         -->
		<!-- ===================================================================== -->
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
		<!-- ===================================================================== -->
		<!-- Protocol & Communication                                             -->
		<!-- ===================================================================== -->
		<PackageVersion Include="ModelContextProtocol" Version="0.3.0-preview.4" />
	</ItemGroup>
</Project>